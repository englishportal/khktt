rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true &&
         request.auth.token.email in ['phamthikhanhhuyen281@gmail.com', 'cl8593834@gmail.com']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isResearcher() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['researcher', 'administrator']
      );
    }

    function isValidAppStatsData(data) {
      return data.keys().hasAll(['totalSuccessfulScans', 'citrus', 'rice', 'peanut', 'updatedAt']) &&
        data.keys().hasOnly(['totalSuccessfulScans', 'citrus', 'rice', 'peanut', 'updatedAt']) &&
        data.totalSuccessfulScans is int &&
        data.totalSuccessfulScans >= 0 &&
        data.totalSuccessfulScans <= 100000000 &&
        data.citrus is int &&
        data.citrus >= 0 &&
        data.citrus <= 100000000 &&
        data.rice is int &&
        data.rice >= 0 &&
        data.rice <= 100000000 &&
        data.peanut is int &&
        data.peanut >= 0 &&
        data.peanut <= 100000000 &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function isValidAppStatsCreate(data) {
      return isValidAppStatsData(data) &&
        data.totalSuccessfulScans == 1 &&
        data.citrus <= 1 &&
        data.rice <= 1 &&
        data.peanut <= 1 &&
        (data.citrus + data.rice + data.peanut) == 1;
    }

    function isValidAppStatsIncrement(data, prev) {
      return data.diff(prev).affectedKeys().hasOnly(['totalSuccessfulScans', 'citrus', 'rice', 'peanut', 'updatedAt']) &&
        data.totalSuccessfulScans == prev.totalSuccessfulScans + 1 &&
        data.citrus >= prev.citrus &&
        data.citrus <= prev.citrus + 1 &&
        data.rice >= prev.rice &&
        data.rice <= prev.rice + 1 &&
        data.peanut >= prev.peanut &&
        data.peanut <= prev.peanut + 1 &&
        (data.citrus + data.rice + data.peanut) == (prev.citrus + prev.rice + prev.peanut + 1);
    }

    // User profiles
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId) && isSignedIn() && request.auth.uid == userId &&
        incoming().id == userId &&
        incoming().email is string &&
        incoming().email.size() <= 256 &&
        incoming().role in ['user', 'researcher', 'administrator'] &&
        (incoming().role == 'user' || isAdmin());
      allow update: if isValidId(userId) && isSignedIn() && (
        (request.auth.uid == userId &&
         incoming().id == userId &&
         incoming().email == existing().email &&
         (isAdmin() || incoming().role == existing().role)) ||
        isAdmin()
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    // Admins list
    match /admins/{userId} {
      allow get: if isValidId(userId) && isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Disease database
    match /diseases/{diseaseId} {
      allow get: if isValidId(diseaseId) && isSignedIn();
      allow list: if isSignedIn();
      allow create, update, delete: if isValidId(diseaseId) && isAdmin();
    }

    // Diagnosis records
    match /diagnoses/{diagnosisId} {
      allow get: if isValidId(diagnosisId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin() || isResearcher());
      allow list: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        isAdmin() ||
        isResearcher()
      );
      allow create: if isValidId(diagnosisId) && isSignedIn() &&
        incoming().userId == request.auth.uid;
      allow update: if isValidId(diagnosisId) && isSignedIn() && (
        (existing().userId == request.auth.uid && incoming().userId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isValidId(diagnosisId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // Research samples
    match /research_samples/{sampleId} {
      allow get: if isValidId(sampleId) && isResearcher();
      allow list: if isResearcher();
      allow create, update, delete: if isValidId(sampleId) && isResearcher();
    }

    // Shared cross-device aggregate scan counters (strictly non-PII, monotonic +1 increment)
    match /app_stats/{statId} {
      allow get: if isValidId(statId) && statId == 'global_scans';
      allow list: if false;
      allow create: if isValidId(statId) && statId == 'global_scans' && isValidAppStatsCreate(incoming());
      allow update: if isValidId(statId) && statId == 'global_scans' && isValidAppStatsData(incoming()) && (
        isValidAppStatsIncrement(incoming(), existing()) ||
        isAdmin()
      );
      allow delete: if false;
    }
  }
}
